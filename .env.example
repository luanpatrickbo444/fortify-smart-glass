# Fortify — configuração para deployment.
# Para uma banca/demonstração, usuário e senha podem continuar os mesmos.
FORTIFY_JWT_SECRET=troque-por-uma-chave-aleatoria-longa-com-32-ou-mais-caracteres
FORTIFY_DEMO_USER=colaborador@fortify.local
FORTIFY_DEMO_PASSWORD=Fortify@123

# MFA primário: segredo Base32 compatível com Google/Microsoft Authenticator, 1Password, Authy etc.
# Se deixado vazio, a opção TOTP não aparecerá.
FORTIFY_TOTP_SECRET=

# MFA alternativo / contingência. Para manter a demonstração atual, pode usar 246810.
# Em ambiente real, use um valor aleatório e rotacione após uso.
FORTIFY_MFA_RECOVERY_CODE=246810

# Compatibilidade com deployments antigos; usado como fallback do código alternativo.
FORTIFY_DEMO_MFA_CODE=246810

FORTIFY_ALLOWED_DEVICE_IDS=FORTIFY-GLASS-001,FORTIFY-GLASS-002

# Opcional: conecte um gateway/LLM corporativo sem alterar o sistema de IA existente.
LLM_ENDPOINT=
LLM_API_KEY=

# Duração da sessão autenticada em segundos (padrão: 14400 = 4h)
FORTIFY_SESSION_TTL_SECONDS=14400
